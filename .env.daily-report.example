# Local daily Telegram report config.
# Copy to .env.daily-report and keep the real file out of Git.

# Optional. If empty, send_daily_report.py can discover the primary recipient
# from ~/Projects/picture-colorizer/data/authorized_users.json.
REPORT_PRIMARY_CHAT_ID=

# Optional comma-separated list. If empty, send_daily_report.py can discover
# the copy recipient from picture-colorizer ADMIN_USER_ID / PDLC allowlist.
REPORT_COPY_CHAT_IDS=

# Optional. Prefer leaving this empty so the script reads the existing
# picture-colorizer TELEGRAM_BOT_TOKEN without storing another token copy.
COLORIZER_BOT_TOKEN=

# Required before real daily sends to the primary recipient.
# Leave false until Sergey confirms that reports should start.
REPORT_PRIMARY_SEND_CONFIRMED=false
