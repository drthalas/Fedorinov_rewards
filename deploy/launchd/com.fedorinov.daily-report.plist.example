<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fedorinov.daily-report</string>

  <key>WorkingDirectory</key>
  <string>/Users/hermes/Projects/Fedorinov_Rewards/Fedorinov_rewards</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>scripts/send_daily_report.py</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/hermes/Projects/Fedorinov_Rewards/Fedorinov_rewards/logs/daily-report.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/hermes/Projects/Fedorinov_Rewards/Fedorinov_rewards/logs/daily-report.err.log</string>
</dict>
</plist>
