<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fedorinov.daily-report</string>

  <key>WorkingDirectory</key>
  <string>/Users/hermes/Projects/Fedorinov_Rewards/Fedorinov_rewards</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>scripts/send_daily_report.py</string>
    <string>--scheduled</string>
  </array>

  <!-- launchd uses the Mac local timezone. Run often and let the script
       send only inside REPORT_TIMEZONE/REPORT_SEND_HOUR. -->
  <key>StartInterval</key>
  <integer>900</integer>

  <key>StandardOutPath</key>
  <string>/Users/hermes/Projects/Fedorinov_Rewards/Fedorinov_rewards/logs/daily-report.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/hermes/Projects/Fedorinov_Rewards/Fedorinov_rewards/logs/daily-report.err.log</string>
</dict>
</plist>
