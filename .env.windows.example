# Windows portable preview configuration.
#
# REWARDS_DATA_DIR must point to the local Rewards data folder that contains:
# - database\MyDatabase.sqlite
# - Source\
# - SourceMark\
# - default\
#
# Working preview mode shows Add/Edit/Delete buttons by default.
# Backup-first protection remains enabled; create a backup before editing real data.
# To disable editing, set READ_ONLY=true and WRITE_MODE=false.
REWARDS_DATA_DIR=C:\Path\To\Rewards
READ_ONLY=false
WRITE_MODE=true
REQUIRE_BACKUP_BEFORE_WRITE=true
APP_HOST=127.0.0.1
APP_PORT=8080
